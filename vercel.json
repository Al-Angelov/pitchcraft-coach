{
  "version": 2,
  "functions": {
    "api/transcribe.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/feedback.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
